{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sloth",
  "scopeName": "source.sloth",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#booleans" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.angle.sloth",
      	  "begin": "<<",
      	  "end": ">>"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sloth",
          "match": "\\b(if|else|return|break|print|do|let)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.sloth",
          "match": "\\b(int|bool|string|list|void)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.sloth",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sloth",
          "match": "\\+|\\-|\\*|\\/|==|!=|<=|>=|<|>|=|&&|\\|\\|"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sloth",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sloth",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sloth",
          "match": "\\\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.sloth",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"
        }
      ]
    }
  }
}
